# WarpOne formal — mask-stack safety, decode completeness, trap behavior (Phase 4).
# Properties are in rtl/core/warpone_core.v under `ifdef FORMAL`.
# Assumption: no CSR writes while running (real host protocol) — stated in DECISIONS D4.1.

[options]
mode prove
depth 12

[engines]
smtbmc z3

[script]
read_verilog -sv -formal -DFORMAL warpone_core.v
prep -top warpone_core

# paths relative to the invocation cwd (repo root); run via `make formal`
[files]
rtl/core/warpone_core.v
rtl/core/warpone_decode.vh
